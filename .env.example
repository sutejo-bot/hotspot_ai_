# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NASA_API_KEY: Required for fetching real-time hotspot data from NASA FIRMS.
# Get a MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/
NASA_API_KEY="MY_NASA_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM BOT: Required for automated background alerts to Telegram
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="MY_TELEGRAM_CHAT_ID"

# FONNTE_TOKEN: Token for WhatsApp notifications using Fonnte API (optional)
FONNTE_TOKEN="MY_FONNTE_TOKEN"
FONNTE_TARGET="085821237889"

# AUTO_NOTIFY_INTERVAL_MINUTES: Interval for background check in minutes (default: 5)
AUTO_NOTIFY_INTERVAL_MINUTES="5"
